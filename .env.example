# Nested Docker execution needs the same absolute path inside the runtime
# container and in the Docker daemon's host namespace. Set this to the local
# checkout's disposable work directory; never point it at source or secrets.
RUNTIME_HOST_WORK_ROOT=/absolute/path/to/fluent-task-runtime/.runtime-work
# Explicit release overlay. Compose mounts this repository's releases at
# /opt/releases. Never point at a mutable or historical descriptor.
# RUNTIME_RELEASE_MANIFEST=/opt/releases/task-release-2026-08-24-qb-d550846f.json
