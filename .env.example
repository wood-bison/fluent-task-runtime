# Nested Docker execution needs the same absolute path inside the runtime
# container and in the Docker daemon's host namespace. Set this to the local
# checkout's disposable work directory; never point it at source or secrets.
RUNTIME_HOST_WORK_ROOT=/absolute/path/to/fluent-task-runtime/.runtime-work
# Optional candidate release overlay. Leave unset until this Question Brain
# release is reconciled with the deployment; the runtime will then report
# manifest-not-configured and legacy compatibility explicitly.
# RUNTIME_RELEASE_MANIFEST=/absolute/path/to/fluent-task-runtime/releases/task-release-2026-08-24.json
